    "eval:printer": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/eval-printer.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "geist": "^1.7.2",
    "lottie-web": "^5.13.0",
